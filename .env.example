# Secret names only. Use the hosting secret store. See docs/d1-release.md.
# ACCESS_HASH is the one-time owner setup code hash, not a login PIN.
ATLAS_ACCESS_HASH=
ATLAS_SESSION_KEY=
ATLAS_INITIAL_GUEST_CODE=
ATLAS_ORIGIN=

# Optional, trusted automation gateway on standalone Cloudflare only.
ATLAS_MCP_GATEWAY_KEY=

# Optional external read-only sources. Set production secrets in the host.
ATLAS_EXTERNAL_API_URL=
ATLAS_EXTERNAL_API_TOKEN=
ATLAS_EXTERNAL_POSTGRES_URL=
ATLAS_EXTERNAL_LIBSQL_URL=
ATLAS_EXTERNAL_LIBSQL_TOKEN=
